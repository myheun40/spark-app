apiVersion: sparkoperator.k8s.io/v1beta2
kind: SparkApplication
metadata:
  name: druid-to-iotdb
  namespace: default
spec:
  type: Python
  pythonVersion: "3"
  mode: cluster
  image: "<registry>/spark/druid-to-iotdb:v1.0"
  imagePullPolicy: Always
  mainApplicationFile: "local:///opt/spark/work-dir/app.py"
  sparkVersion: "3.4.0"
  
  # Spark 설정 (Avatica JDBC 패키지를 직접 의존성 추가할 수도 있음)
  sparkConf:
    "spark.serializer": "org.apache.spark.serializer.KryoSerializer"
    
  # 환경변수로 접속 세팅 주입
  driver:
    cores: 1
    coreLimit: "1200m"
    memory: "2g"
    labels:
      version: 3.4.0
    serviceAccount: spark-operator-spark # Spark 실행용 ServiceAccount
    env:
      - name: DRUID_HOST
        value: "<druid_host>"
      - name: DRUID_PORT
        value: "8082"
      - name: IOTDB_HOST
        value: "<iotdb_host>"
      - name: IOTDB_PORT
        value: "6667"
        
  executor:
    cores: 2
    instances: 3
    memory: "4g"
    labels:
      version: 3.4.0
    env:
      - name: DRUID_HOST
        value: "<druid_host>"
      - name: DRUID_PORT
        value: "8082"
      - name: IOTDB_HOST
        value: "<iotdb_host>"
      - name: IOTDB_PORT
        value: "6667"
